{
  "name": "@durust/eslint-plugin",
  "version": "0.2.1",
  "description": "ESLint rules for deterministic Durust workflow code.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "prepack": "tsc -b",
    "test": "vitest run --root ../.. --config vitest.config.ts packages/eslint-plugin/test"
  },
  "peerDependencies": {
    "eslint": ">=8.57.0 || >=9.0.0"
  },
  "license": "MIT",
  "keywords": [
    "durust",
    "durable-execution",
    "durable-workflows",
    "workflow",
    "workflow-engine",
    "temporal-alternative",
    "eslint",
    "eslint-plugin",
    "determinism",
    "node"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danthegoodman1/durust.git",
    "directory": "typescript/packages/eslint-plugin"
  }
}
