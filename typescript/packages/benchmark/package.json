{
  "name": "@durust/benchmark",
  "version": "0.2.2",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "durust-benchmark-workload": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.json"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run --root ../.. --config vitest.config.ts packages/benchmark/test"
  },
  "dependencies": {
    "@durust/core": "^0.2.2",
    "@durust/native": "^0.2.2",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "@durust/testing": "^0.2.2",
    "@types/pg": "^8.20.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/danthegoodman1/durust"
  }
}
