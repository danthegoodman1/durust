{
  "name": "@durust/testing",
  "version": "0.2.0",
  "description": "Shared provider conformance tests for Durust TypeScript backends.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@durust/core": "^0.2.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "prepack": "tsc -b",
    "test": "vitest run --root ../.. --config vitest.config.ts packages/testing/test"
  },
  "license": "MIT",
  "keywords": [
    "durust",
    "durable-execution",
    "durable-workflows",
    "workflow",
    "workflow-engine",
    "temporal-alternative",
    "testing",
    "conformance",
    "node"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danthegoodman1/durust.git",
    "directory": "typescript/packages/testing"
  }
}
