{
  "name": "@durust/core",
  "version": "0.2.2",
  "description": "Durable workflow runtime core for TypeScript and Node.js.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "durust-manifest": "./dist/manifest-cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "prepack": "tsc -b",
    "test": "vitest run --root ../.. --config vitest.config.ts packages/core/test"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3"
  },
  "license": "MIT",
  "keywords": [
    "durust",
    "durable-execution",
    "durable-workflows",
    "workflow",
    "workflow-engine",
    "temporal-alternative",
    "node"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/danthegoodman1/durust",
    "directory": "typescript/packages/core"
  },
  "devDependencies": {
    "@durust/native": "^0.2.2"
  }
}
